DISCORD_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=your_test_server_id_here

# Optional: join this voice channel to create a temporary room.
TEMP_VOICE_LOBBY_ID=
TEMP_VOICE_NAME="{user}'s room"
# Numbers are appended automatically; use {number} to choose their position.
TEMP_VOICE_STATUS=
# Example: TEMP_VOICE_STATUS="Room {number} • Hosted by {user}"

# Disconnect when n00bot is the only occupant (seconds, 0 disables).
VOICE_ALONE_TIMEOUT=120

# Docker: match the owner of the host data/ directory (defaults to 1000).
BOT_UID=1000
BOT_GID=1000
